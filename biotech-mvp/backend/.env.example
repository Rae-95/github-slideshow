# ── 服务配置 ─────────────────────────────────────────────
PORT=4000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# ── JWT密钥（生产环境务必替换为随机字符串）────────────────
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# ── 数据库（PostgreSQL）───────────────────────────────────
# 方式1：完整连接字符串（用于云数据库/Railway/Supabase）
DATABASE_URL=postgresql://user:password@localhost:5432/biolink_mvp

# 方式2：逐项配置（本地开发）
DB_HOST=localhost
DB_PORT=5432
DB_NAME=biolink_mvp
DB_USER=postgres
DB_PASSWORD=your_db_password

# ── AI服务 ────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-api-your-key-here
# OPENAI_API_KEY=sk-your-openai-key  # 备选AI服务

# ── 邮件通知（可选，生产环境配置）────────────────────────
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=noreply@biolink.com
SMTP_PASS=your_smtp_password
FROM_EMAIL=BioLink <noreply@biolink.com>
